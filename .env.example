# Environment example for Daraja STK Push backend

# Daraja (Safaricom) credentials
CONSUMER_KEY=
CONSUMER_SECRET=
SHORTCODE=
PASSKEY=

# public base URL reachable by Safaricom (use ngrok for local testing)
CALLBACK_BASE_URL=

# Optional: sandbox or production base URL. Default is sandbox.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke

# Server port
PORT=3000
